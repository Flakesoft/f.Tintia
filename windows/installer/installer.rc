#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "installer.manifest"
IDI_APP_ICON ICON "../runner/resources/app_icon.ico"


1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Flakesoft"
            VALUE "FileDescription", "f.Tintia Setup"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "f.Tintia Setup"
            VALUE "OriginalFilename", "f.Tintia Setup.exe"
            VALUE "ProductName", "f.Tintia"
            VALUE "ProductVersion", "1.0.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END